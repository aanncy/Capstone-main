# Copy this file to .env and fill it in. NEVER commit .env.

# GitHub fine-grained personal access token with the "Models" permission (read).
# Create at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Which providers to try, in order. If one fails, the next is used.
# Options: github_models, gemini, copilot_sdk  (e.g. PROVIDERS=gemini,github_models)
PROVIDERS=github_models

# Google Gemini API key (free tier is fine). Create at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini model id. List them with: python -m scripts.try_it --list
GEMINI_MODEL=gemini-flash-latest

# Model id from the GitHub Models catalog. List them with: python -m scripts.try_it --list
GITHUB_MODEL=openai/gpt-4.1

# Model name for the Copilot SDK provider (only used if copilot_sdk is in PROVIDERS)
COPILOT_MODEL=gpt-4.1
